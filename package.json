{
    "name": "auto-watch",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check ."
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@octokit/plugin-throttling": "^11.0.5",
        "@octokit/rest": "^22.0.1",
        "picomatch": "^4.0.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/picomatch": "^4.0.3",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitest": "^5.0.4"
    }
}
