{
    "name": "auto-watch",
    "version": "1.0.3",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/auto-watch.git"
    },
    "packageManager": "bun@1.4.4",
    "private": true,
    "type": "module",
    "license": "MIT",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "audit": "bun audit --audit-level=high"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@octokit/plugin-throttling": "^11.0.5",
        "@octokit/request-error": "^7.1.2",
        "@octokit/rest": "^22.0.1",
        "picomatch": "^4.0.7"
    },
    "devDependencies": {
        "@jubstaa/config": "^1.6.0",
        "@types/node": "^26.6.6",
        "@types/picomatch": "^4.0.3",
        "@typescript/native": "npm:typescript@^7.0.2",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^5.1.1"
    }
}
